{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "echo 'driver-dist has no build step (zero dependencies)'",
    "watchPatterns": ["apps/driver-dist/**", "railway.driver-dist.json"]
  },
  "deploy": {
    "startCommand": "node apps/driver-dist/server.mjs",
    "healthcheckPath": "/healthz",
    "healthcheckTimeout": 60,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
