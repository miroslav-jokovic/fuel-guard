# FuelGuard McLeod sync agent — configuration.
# Copy this file to `.env` (or set these as real environment variables) and fill in the values.

# ── FuelGuard (required) ────────────────────────────────────────────────────────────────────────────
# Your FuelGuard base URL (no trailing slash).
FUELGUARD_INGEST_URL=https://your-fuelguard-url.example.com
# The ingest token from FuelGuard → Settings → Integrations → McLeod → "Enable" (shown once). Starts with fgtms_.
FUELGUARD_INGEST_TOKEN=fgtms_paste_the_token_here

# ── Which source to read from ─────────────────────────────────────────────────────────────────────────
# Start with 'mock' to prove the FuelGuard connection works, then switch to 'mcleod'.
SOURCE=mock

# How far back to pull on the FIRST run (after that the agent remembers where it left off, in state.json).
LOOKBACK_DAYS=35

# 0 = run once and exit (good with Windows Task Scheduler / cron). >0 = stay running and sync every N minutes.
INTERVAL_MINUTES=0

# ── McLeod LoadMaster (only needed when SOURCE=mcleod) ────────────────────────────────────────────────
# Self-hosted / Direct-Hosted API base. Keep this private; the agent must run on the same network/VPN.
MCLEOD_WS_URL=https://your-loadmaster-host/ws
# Sent as McLeod's documented AnywhereCompanyID header (often TMS, TMS2, etc.).
MCLEOD_COMPANY=TMS
# Preferred: token registered in LoadMaster/PowerBroker. Use either this token OR username/password below.
MCLEOD_WS_TOKEN=the_web_service_token_mcleod_issues
# MCLEOD_WS_USERNAME=read_only_integration_user
# MCLEOD_WS_PASSWORD=replace_me

# McLeod limits searches to 1,000 rows per page. Lower this if your server needs smaller requests.
MCLEOD_PAGE_SIZE=1000

# Carrier-specific equipment codes that mean a reefer load (comma separated). Confirm with one known load.
MCLEOD_REEFER_EQUIPMENT_TYPES=REEFER,R

# Optional. McLeod's public DriverService docs do not publish a time-off endpoint. Only set this to a route
# McLeod Support has confirmed for your installation. Use {since} where the ISO watermark belongs.
# MCLEOD_DRIVER_TIMEOFF_PATH=/your-supported-route?changedAfterDate={since}
