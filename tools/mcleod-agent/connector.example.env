# Silvicom 360 connector — configuration for the Board VM (`agent.mjs --service`).
#
# Copy to `connector.env` in the connector's folder and fill in the two secrets. Readable by the
# service account only. QUOTE every secret: Node's --env-file cuts an unquoted value at the first `#`,
# and a password that quietly lost its last characters fails as a bare "Login failed".

# ── Where the data goes (outbound HTTPS only) ─────────────────────────────────────────────────────
# The api service, not the web one: the two deploy separately (COLLECTOR-AUDIT-2026-09-24.md F8).
FUELGUARD_INGEST_URL=https://fleetguardapi-production.up.railway.app
# The fgtms_… token from Silvicom → Settings → Integrations → McLeod. Silvicom sends it separately.
FUELGUARD_INGEST_TOKEN="fgtms_REPLACE_ME"

# ── LME (read-only) ───────────────────────────────────────────────────────────────────────────────
MCLEOD_SQL_SERVER=10.0.1.171
MCLEOD_SQL_PORT=1433
MCLEOD_SQL_DATABASE=lme
MCLEOD_SQL_USER=silvicom_dispatch_ro
MCLEOD_SQL_PASSWORD="REPLACE_ME"
# dbo.company.id. TMS is the trucking company; TMS2/TMS3 are never read.
MCLEOD_COMPANY_ID=TMS

# Encryption — the carrier's choice (letter, question 3). Exactly one of:
#   (a) a trusted certificate:     MCLEOD_SQL_SERVERNAME=<hostname on the certificate>
#                                  MCLEOD_SQL_TRUST_CERT=false
#   (b) encrypt, self-signed cert: MCLEOD_SQL_SERVERNAME=APPNEW   (the default below; tested on
#                                  APPNEW 2026-09-24: sys.dm_exec_connections.encrypt_option = TRUE)
#   (c) no encryption on the LAN:  MCLEOD_SQL_ENCRYPT=false
# The connector refuses an encrypted connection to a bare IP rather than silently downgrading.
MCLEOD_SQL_SERVERNAME=APPNEW

# ── What the feeds read ───────────────────────────────────────────────────────────────────────────
SOURCE=mcleod
# identity = the roster fields the letter lists (names, licence, medical, hire date, address, email).
ROSTER_MODE=identity
# Accounts that are not people; their loads show "no dispatcher" rather than an invented one.
MCLEOD_SYSTEM_DISPATCHERS=loadmaster,lmeadm

# Finance stays OFF in the service until the finance grants are on LME (Alex, 2026-09-24): they go on
# the analytics copy first, for one night checked with `agent.mjs --financial --dry-run`, and on LME
# after. Turn it on that day by deleting this line or setting it to `on`, then restart the service.
FINANCE_FEED=off

# The cadences are fixed in schedule.mjs (loads 1 min, close 10 min, roster 15 min, finance 02:00
# Central) because they are what the carrier approved — they are deliberately not settings here.
