{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Edit(supabase/migrations/**)",
      "Write(supabase/migrations/**)",
      "Edit(//Users/miroslavjokovic/Projects/FuelGuard-release/supabase/migrations/**)",
      "Write(//Users/miroslavjokovic/Projects/FuelGuard-release/supabase/migrations/**)",
      "Bash(pnpm mcleod:inspect)",
      "Bash(pnpm mcleod:report)",
      "Bash(pnpm lint:mcleod-recon)",
      "Bash(node scripts/check-mcleod-recon.mjs)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)",
      "Read(*.env)",
      "Read(!*.example.env)"
    ]
  },
  "extraKnownMarketplaces": {
    "ui-ux-pro-max-skill": {
      "source": {
        "source": "github",
        "repo": "nextlevelbuilder/ui-ux-pro-max-skill"
      }
    },
    "impeccable": {
      "source": {
        "source": "github",
        "repo": "pbakaus/impeccable"
      }
    }
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "ui-ux-pro-max@ui-ux-pro-max-skill": true,
    "impeccable@impeccable": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "graphify hook-guard search"
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "graphify hook-guard read"
          }
        ]
      }
    ]
  }
}
