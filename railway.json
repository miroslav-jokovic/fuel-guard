{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "corepack enable && pnpm install --frozen-lockfile --prod=false && rm -rf apps/web/dist && pnpm --filter @fuelguard/web build",
    "watchPatterns": [
      "**",
      "!**/*.md",
      "!**/*.mdx",
      "!docs/**",
      "!.github/**",
      "!.claude/**",
      "!.vscode/**",
      "!.idea/**",
      "!.editorconfig",
      "!.gitignore",
      "!.gitattributes",
      "!**/.DS_Store",
      "!**/*.test.ts",
      "!**/*.test.tsx",
      "!**/*.test.mjs",
      "!**/*.spec.ts",
      "!**/*.spec.tsx",
      "!**/__tests__/**"
    ]
  },
  "deploy": {
    "startCommand": "pnpm --filter @fuelguard/api start",
    "healthcheckPath": "/healthz",
    "healthcheckTimeout": 100,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
