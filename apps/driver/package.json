{
  "name": "@fuelguard/driver",
  "version": "0.0.1",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "shared": "pnpm --filter @fuelguard/shared build:rn",
    "start": "pnpm run shared && expo start --dev-client",
    "android": "pnpm run shared && expo run:android",
    "ios": "pnpm run shared && expo run:ios",
    "prebuild": "expo prebuild",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:tokens": "node scripts/check-driver-tokens.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@expo-google-fonts/hanken-grotesk": "^0.4.3",
    "@fuelguard/shared": "workspace:*",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/netinfo": "*",
    "@supabase/supabase-js": "2.110.0",
    "@tanstack/query-async-storage-persister": "^5.90.2",
    "@tanstack/react-query": "^5.90.2",
    "@tanstack/react-query-persist-client": "^5.90.2",
    "aes-js": "^3.1.2",
    "expo": "^57.0.0",
    "expo-constants": "*",
    "expo-crypto": "*",
    "expo-dev-client": "*",
    "expo-file-system": "*",
    "expo-font": "*",
    "expo-haptics": "^57.0.1",
    "expo-linking": "*",
    "expo-router": "*",
    "expo-secure-store": "*",
    "expo-sqlite": "*",
    "expo-status-bar": "*",
    "expo-system-ui": "*",
    "nativewind": "^4.1.23",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "^2.32.0",
    "react-native-get-random-values": "^1.11.0",
    "react-native-reanimated": "^4.5.0",
    "react-native-safe-area-context": "^5.7.0",
    "react-native-screens": "*",
    "react-native-svg": "*",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-worklets": "^0.10.0",
    "tailwindcss": "3.4.17",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/aes-js": "^3.1.4",
    "@types/react": "~19.2.0",
    "eslint": "10.6.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.62.1",
    "vitest": "4.1.9"
  }
}
