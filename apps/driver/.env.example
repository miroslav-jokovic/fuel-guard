EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# EXPO_PUBLIC_API_URL — pick the value that matches how you're testing.
#
# Default: localhost:8080. Works for
#   • iOS Simulator                                 (Simulator shares the Mac's localhost)
#   • Android Emulator with adb reverse             (`pnpm --filter @silvicom/driver adb:reverse`)
#   • Android USB device with adb reverse           (same command; run every time you plug in)
#
# Override with your Mac's LAN IP ONLY when
#   • iOS device connected by USB or wifi           (iOS has no adb-reverse equivalent — needs LAN)
#   • Android USB but adb reverse is not available  (rare)
#
# The scripts (`pnpm --filter @silvicom/driver start:usb` / `android`) run adb reverse for you
# automatically. If you're doing that, keep the default below and don't touch this file.
EXPO_PUBLIC_API_URL=https://fleetguardweb-production.up.railway.app
