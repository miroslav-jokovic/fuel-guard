VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
VITE_API_URL=http://localhost:8080

# Set to "true" to skip Supabase auth and inject a local admin session (frontend dev only).
VITE_DEV_BYPASS=false

# Names the deployment in a strip above every page, including sign-in. Unset (or "production") shows
# nothing — a marker that appears everywhere marks nothing. Set to "uat" on the UAT deployment, whose
# only other difference from production is the hostname because both read the same database.
VITE_APP_ENVIRONMENT=
