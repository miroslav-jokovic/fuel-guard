            <div role="tooltip" class="invisible absolute left-0 top-full z-popover mt-1 w-56 rounded-surface bg-surface p-3 text-xs shadow-overlay ring-1 ring-edge group-focus-within:visible group-hover:visible">
              <p class="font-medium text-ink">Commercial driver's licence</p>
              <p class="text-ink-muted"> Good until 01/01/2030</p>
              <!-- The paper's own date (Q-UF10). "Filed … by" only when a person filed it here: an imported
             McLeod paper's filing date is the import run, which says nothing about the paper. -->
              <p class="text-ink-muted">Dated 03/01/2026</p>
              <!--v-if--><button type="button" class="inline-flex items-center transition-colors justify-center whitespace-nowrap rounded-control font-semibold focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus-ring disabled:pointer-events-none disabled:text-ink-disabled disabled:opacity-60 text-ink-secondary hover:bg-surface-muted hover:text-ink h-8 gap-x-1 px-2.5 text-sm mt-2 -ml-2"><svg width="24" height="24" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" fill="none" color="currentColor" class="size-4" aria-hidden="true">
                  <path d="M16.9504 12.1817C17.1981 12.814 16.5076 13.5726 15.1267 15.0899C13.6702 16.6902 12.9201 17.4904 12 17.5C11.0799 17.4904 10.3298 16.6902 8.87331 15.0899C7.49239 13.5726 6.80193 12.814 7.04964 12.1817C7.05868 12.1586 7.06851 12.1359 7.0791 12.1135C7.34928 11.542 8.24477 11.5029 10 11.5002V4.99998C10 4.53501 10 4.30253 10.0511 4.11179C10.1898 3.59414 10.5941 3.1898 11.1118 3.05111C11.3025 3 11.535 3 12 3C12.4649 3 12.6974 3 12.8882 3.05111C13.4058 3.1898 13.8102 3.59414 13.9489 4.11179C14 4.30253 14 4.53501 14 4.99998V11.5002C15.7552 11.5029 16.6507 11.542 16.9209 12.1135C16.9315 12.1359 16.9413 12.1586 16.9504 12.1817Z" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path>
                  <path d="M5.00006 21H19.0001" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path>
                </svg> Download </button>
            </div>
          </div>
          <div class="group relative" data-test="file-thumb"><button type="button" class="inline-flex items-center transition-colors justify-center whitespace-nowrap rounded-control font-semibold focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus-ring disabled:pointer-events-none disabled:text-ink-disabled disabled:opacity-60 text-ink-secondary hover:bg-surface-muted hover:text-ink h-8 gap-x-1 px-2.5 text-sm size-8 overflow-hidden rounded-detail p-0 ring-1 ring-edge" aria-label="Open Driving record inquiry for Marcus Reyes"><svg width="24" height="24" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" fill="none" color="currentColor" class="size-4 text-ink-tertiary" aria-hidden="true">
