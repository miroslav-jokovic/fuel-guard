      <td class="px-4 py-3 text-left text-ink-secondary">T-118</td>
      <td class="px-4 py-3 text-left text-ink-secondary">Joliet, IL</td>
      <td class="px-4 py-3 text-left">
        <div class="inline-flex items-center gap-1.5" title="Username: mreyes"><span class="inline-flex items-center gap-1 rounded-detail px-2 py-0.5 text-xs font-medium bg-success-50 text-success-700 ring-1 ring-inset ring-success-600/20">Active</span><span class="font-mono text-xs text-ink-muted">mreyes</span></div>
      </td>
      <td class="px-4 py-3 text-left">
        <!-- Drag events augment the thumb buttons, as on \`FileDropzone\`; the container is not a control. -->
        <!-- eslint-disable-next-line vuejs-accessibility/no-static-element-interactions -->
        <div class="flex items-center gap-2 rounded-control transition-colors" data-test="file-cell">
          <div class="group relative" data-test="file-thumb"><button type="button" class="inline-flex items-center transition-colors justify-center whitespace-nowrap rounded-control font-semibold focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus-ring disabled:pointer-events-none disabled:text-ink-disabled disabled:opacity-60 text-ink-secondary hover:bg-surface-muted hover:text-ink h-8 gap-x-1 px-2.5 text-sm size-8 overflow-hidden rounded-detail p-0 ring-1 ring-edge" aria-label="Open Commercial driver's licence for Marcus Reyes"><img src="https://signed.test/cdl-1.webp" alt="" class="size-full object-cover" loading="lazy"></button>
            <!-- The hover card: what the paper is and until when. Shown on focus too, so a keyboard reader
