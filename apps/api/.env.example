NODE_ENV=development
PORT=8080
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# In production set these to the Railway app domain (the URL users visit in their browser and
# click in invite emails). This is NOT the email sender domain — see MAIL_FROM below.
# Production: https://fleetguardweb-production.up.railway.app
ALLOWED_ORIGINS=http://localhost:5173
WEB_APP_URL=http://localhost:5173
SAMSARA_API_TOKEN=samsara_api_your-token-here
SAMSARA_API_URL=https://api.samsara.com
# Driver-performance score refresh cadence (current week), hours. Default 6.
SAMSARA_DRIVER_SCORE_SYNC_HOURS=6

# ── Email delivery (Resend) ────────────────────────────────────────────────────
# 1. Create an account at https://resend.com and get a free API key.
# 2. Set RESEND_API_KEY below — MAIL_PROVIDER is auto-detected from the key.
# 3. MAIL_FROM uses Resend's shared sender (onboarding@resend.dev) by default.
#    No DNS verification required — just the API key is enough.
#
# When you have DNS access to silvicominc.com, verify it in resend.com/domains
# and switch MAIL_FROM to: FuelGuard <miki@silvicominc.com>
MAIL_PROVIDER=resend
RESEND_API_KEY=re_your_api_key_here
MAIL_FROM=FuelGuard <onboarding@resend.dev>

# ── GovInfo API (api.govinfo.gov) ─────────────────────────────────────────────
# Used for HMDB / regulatory data lookups (HazmatGuard). Generate at: https://api.govinfo.gov
GOVINFO_API_KEY=your-govinfo-api-key-here
PSP_API_KEY_UAT=your-psp-uat-token-here
# PSP_API_KEY_PRODUCTION=set-this-only-on-a-deploy-that-may-spend
PSP_UNIT_PRICE_USD=10

# ── HERE Routing API ──────────────────────────────────────────────────────────
# Used for truck-route geometry fetching + caching (route_geometries table).
# Generate at: https://platform.here.com/portal/
HERE_API_KEY=your-here-api-key-here

# Run background schedulers in this API process (default true). Set to false on the API service
# when a dedicated single-replica worker service runs them. See docs/WORKER-DEPLOYMENT.md.
RUN_SCHEDULERS_IN_PROCESS=true

# ── EFS SOAP integration (docs/plans/EFS-SOAP-INTEGRATION-PLAN.md) ────────────
# In-house EFS webservice for posted transactions + rejected authorization attempts (one credential
# set, both feeds). Per-org credentials live in the efs_soap_credentials table (migration 0091);
# the vars below are single-tenant fallbacks. Leave EFS_SOAP_ENABLED=false until (a) credentials
# are stored, (b) IP allowlisting is confirmed with EFS, and (c) sandbox certification passes.
EFS_SOAP_ENABLED=false
EFS_SOAP_ENVIRONMENT=production
# Production endpoint supplied by EFS (the WSDL document is this URL plus ?wsdl).
# EFS_SOAP_ENDPOINT_URL=https://ws.efsllc.com/axis2/services/CardManagementWS/
# EFS_SOAP_USERNAME=…
# EFS_SOAP_PASSWORD=…
# EFS_SOAP_ACCOUNT_ID=…                                    (optional metadata; not sent in transaction requests)
# EFS_SOAP_ORG_ID=…                                       (recommended: scope Railway fallback to one org)
# Poll cadences (minutes). EFS recommends 15 minutes for both feeds on this account.
EFS_SOAP_POSTED_POLL_MINUTES=15
EFS_SOAP_REJECTED_POLL_MINUTES=15
# Client rate limit + retry budget.
EFS_SOAP_MAX_RPS=2
EFS_SOAP_MAX_RETRIES=4
# Initial-sync backfill window (days). Bounded 1–730; requests are split at EFS_SOAP_MAX_DAYS_PER_REQUEST.
EFS_SOAP_BACKFILL_DAYS=90
# EFS confirmed a 30-day maximum request window for production.
EFS_SOAP_MAX_DAYS_PER_REQUEST=30
# Optional egress proxy for the EFS SOAP client only (static-IP hop for EFS's allowlist). Leave unset
# when Railway Pro static outbound IPs are enabled at the platform level.
# EFS_SOAP_EGRESS_PROXY_URL=http://proxy.example.com:3128
