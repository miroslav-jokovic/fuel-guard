{
  "name": "fuelguard",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "driver:ios": "pnpm --filter @fuelguard/driver ios",
    "driver:android": "pnpm --filter @fuelguard/driver android",
    "driver:start": "pnpm --filter @fuelguard/driver start",
    "driver:start:usb": "pnpm --filter @fuelguard/driver start:usb",
    "driver:adb:reverse": "pnpm --filter @fuelguard/driver adb:reverse",
    "driver:adb:devices": "pnpm --filter @fuelguard/driver adb:devices",
    "driver:clean": "pnpm --filter @fuelguard/driver clean",
    "driver:doctor": "node scripts/driver-doctor.mjs",
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test && pnpm test:rls",
    "//test:rls": "Standalone node scripts, so `pnpm -r test` never reached them: both RLS matrices sat un-runnable for months (stale migration filenames, an under-shimmed storage schema) while the ledger still quoted their pass counts, and two real driver-scope leaks hid behind that. Wired into `test` so CI runs them.",
    "test:rls": "node supabase/tests/rls.test.mjs && node supabase/tests/hazmat_rls.test.mjs",
  "//verify:live": "Answers \"why don't I see my changes?\" in one command: compares git HEAD + the highest migration file against the deployed API's GET /api/version. Exits non-zero on drift.",
  "verify:live": "node scripts/verify-live.mjs",
    "gen": "pnpm gen:rules",
    "gen:rules": "node scripts/gen-rule-catalog.mjs",
    "lint": "eslint .",
    "lint:filesize": "node scripts/check-file-size.mjs",
    "lint:funcsize": "node scripts/check-function-size.mjs",
    "lint:migrations": "node scripts/check-migration-versions.mjs",
    "lint:boundaries": "node scripts/check-feature-boundaries.mjs && node scripts/check-feature-catalog-parity.mjs",
    "lint:codegen": "node scripts/gen-rule-catalog.mjs && git diff --exit-code -- 'packages/**/*.generated.ts'",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:tokens-parity": "node scripts/check-token-parity.mjs",
    "postinstall": "node scripts/apply-patches.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "vue-demi"
    ]
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.6.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.9.2",
    "expo-module-scripts": "5.0.6",
    "prettier": "3.9.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.62.1"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.4"
  }
}
