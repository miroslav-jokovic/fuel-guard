{
  "compilerOptions": {
    "target": "ESNext", "module": "ESNext", "moduleResolution": "bundler", "strict": true,
    "verbatimModuleSyntax": true, "noUncheckedIndexedAccess": true, "resolveJsonModule": true,
    "esModuleInterop": true, "skipLibCheck": true, "noEmit": true, "noUnusedLocals": true,
    "noUnusedParameters": true, "types": ["node"], "lib": ["ESNext"]
  },
  "include": ["src/**/*.ts"]
}
