exports[`DataTable rendering, pinned across the R3b extraction > renders the narrow card list unchanged 1`] = `
"<div class="rounded-surface bg-transparent" data-card-list="">
  <!--Narrow: one card per row. Same slots, same data, no table.-->
  <!--The sort is one compact control at the list's edge, not a bar across it (D-SM7): the bar read as a second toolbar under the first, and its select stretched to the screen for a five-word option.-->
  <div class="flex items-center justify-end gap-2 pb-2"><label class="text-xs font-medium text-ink-muted" for="dt-test-sort">Sort</label><select id="dt-test-sort" class="max-w-[60%] rounded-control bg-surface py-1.5 pr-7 pl-2 text-sm text-ink-secondary ring-1 ring-inset ring-edge-control" value="unit">
      <option value="">Default order</option>
      <option value="unit">Unit</option>
      <option value="gallons">Gallons</option>
    </select><button type="button" class="rounded-control bg-surface px-2 py-1.5 text-sm font-medium text-ink-secondary ring-1 ring-inset ring-edge-control" aria-label="Sorted ascending, switch to descending">↑</button></div>
  <!--Two-up once the LIST has 40rem, whatever the window is (D-SM6): phone landscape and the bay's tablet get two columns, a 390 px phone and a narrow drawer get one. Only boxed cards pair up — two columns of flat rows share their hairlines and read as a broken table.-->
  <div class="@container">
    <ul class="grid grid-cols-1 items-start gap-2 @[40rem]:grid-cols-2">
      <!--eslint-disable-next-line vuejs-accessibility/click-events-have-key-events, vuejs-accessibility/no-static-element-interactions -- the table row's own click, which has no key handler either; a link in a cell is the keyboard's way in-->
      <li class="rounded-surface p-4 bg-surface shadow-card ring-1 ring-edge-subtle relative" data-card="">
        <div class="flex items-start gap-3">
          <!--eslint-disable-next-line vuejs-accessibility/click-events-have-key-events, vuejs-accessibility/no-static-element-interactions -- stops the card's click; the checkbox inside is the control--><label class="-my-3 -ml-3 flex shrink-0 items-center justify-center [&amp;_a]:relative [&amp;_a]:z-raised [&amp;_button]:relative [&amp;_button]:z-raised [&amp;_input]:relative [&amp;_input]:z-raised size-10"><input type="checkbox" class="size-4 rounded-control border-edge-control accent-brand-600" checked="" aria-label="Select Unit 204"></label>
          <div class="min-w-0 flex-1">
            <!--Identifier, its one date or amount, and the status share the top line: the things a scan is looking for. The identifier gives way (truncates); the others never wrap.-->
            <div class="flex items-center gap-2">
              <div class="min-w-0 flex-1 truncate text-base font-semibold text-ink">Unit 204</div>
              <div class="[&amp;_a]:relative [&amp;_a]:z-raised [&amp;_button]:relative [&amp;_button]:z-raised [&amp;_input]:relative [&amp;_input]:z-raised shrink-0"><span data-testid="status-slot">ok</span></div><!--eslint-disable-next-line vuejs-accessibility/click-events-have-key-events, vuejs-accessibility/no-static-element-interactions -- a control column is its own button; this only keeps its click off the card-->
            </div>
            <!--One line of context, its parts joined by a dot: "Driving · 733 · Indianapolis, IN". A line each is what made a card a form; the shop's single sentence is the same markup with nothing to join.-->
            <!--v-if-->
          </div><!--eslint-disable-next-line vuejs-accessibility/click-events-have-key-events, vuejs-accessibility/no-static-element-interactions -- stops the card's click; the menu inside is its own button-->
          <div class="[&amp;_a]:relative [&amp;_a]:z-raised [&amp;_button]:relative [&amp;_button]:z-raised [&amp;_input]:relative [&amp;_input]:z-raised relative z-raised -my-1 shrink-0"><button type="button" data-testid="row-actions">Actions</button></div>
        </div>
        <!--Under the top row and the card's FULL width — beside a checkbox and a menu the grid lost a quarter of the card and clipped a badge (browser pass, 2026-11-14). A fixed three-column grid, never a wrapping row: the wrapping row is what left the sixth figure alone on a line. Labels fill one grid row and values the next, so a label that takes two lines ("Medical expires" at 390 px) cannot push its own value below its neighbours'.-->
        <dl class="mt-3 grid auto-cols-fr grid-flow-col grid-rows-[auto_auto] gap-x-3 border-t border-edge-subtle pt-3 [&amp;_a]:relative [&amp;_a]:z-raised [&amp;_button]:relative [&amp;_button]:z-raised [&amp;_input]:relative [&amp;_input]:z-raised" data-card-figures="">
          <dt class="min-w-0 self-end text-2xs uppercase tracking-wide text-ink-muted [overflow-wrap:anywhere]">Driver</dt>
          <dd class="mt-0.5 min-w-0 text-sm font-medium text-ink [overflow-wrap:anywhere]">Marcus Reyes</dd>
          <dt class="min-w-0 self-end text-2xs uppercase tracking-wide text-ink-muted [overflow-wrap:anywhere]">Gallons</dt>
          <dd class="mt-0.5 min-w-0 text-sm font-medium text-ink [overflow-wrap:anywhere] tabular-nums">118.4</dd>
        </dl>
        <div class="[&amp;_a]:relative [&amp;_a]:z-raised [&amp;_button]:relative [&amp;_button]:z-raised [&amp;_input]:relative [&amp;_input]:z-raised mt-2.5">
          <div data-testid="expanded">detail</div>
        </div>
        <!--The rest (D-SM4). Hidden, not absent: find-in-page, a screen reader's cursor and the page tests all read it here. The label column is FIXED, so values start at one x on every card of every list.-->
        <!--v-if-->
      </li>
      <li class="rounded-surface p-4 bg-surface shadow-card ring-1 ring-edge-subtle relative" data-card="">
        <div class="flex items-start gap-3">
          <!--eslint-disable-next-line vuejs-accessibility/click-events-have-key-events, vuejs-accessibility/no-static-element-interactions -- stops the card's click; the checkbox inside is the control--><label class="-my-3 -ml-3 flex shrink-0 items-center justify-center [&amp;_a]:relative [&amp;_a]:z-raised [&amp;_button]:relative [&amp;_button]:z-raised [&amp;_input]:relative [&amp;_input]:z-raised size-10"><input type="checkbox" class="size-4 rounded-control border-edge-control accent-brand-600" aria-label="Select Unit 991"></label>
          <div class="min-w-0 flex-1">
            <!--Identifier, its one date or amount, and the status share the top line: the things a scan is looking for. The identifier gives way (truncates); the others never wrap.-->
            <div class="flex items-center gap-2">
              <div class="min-w-0 flex-1 truncate text-base font-semibold text-ink">Unit 991</div>
              <div class="[&amp;_a]:relative [&amp;_a]:z-raised [&amp;_button]:relative [&amp;_button]:z-raised [&amp;_input]:relative [&amp;_input]:z-raised shrink-0"><span data-testid="status-slot">none</span></div><!--eslint-disable-next-line vuejs-accessibility/click-events-have-key-events, vuejs-accessibility/no-static-element-interactions -- a control column is its own button; this only keeps its click off the card-->
            </div>
            <!--One line of context, its parts joined by a dot: "Driving · 733 · Indianapolis, IN". A line each is what made a card a form; the shop's single sentence is the same markup with nothing to join.-->
            <!--v-if-->
          </div><!--eslint-disable-next-line vuejs-accessibility/click-events-have-key-events, vuejs-accessibility/no-static-element-interactions -- stops the card's click; the menu inside is its own button-->
          <div class="[&amp;_a]:relative [&amp;_a]:z-raised [&amp;_button]:relative [&amp;_button]:z-raised [&amp;_input]:relative [&amp;_input]:z-raised relative z-raised -my-1 shrink-0"><button type="button" data-testid="row-actions">Actions</button></div>
        </div>
        <!--Under the top row and the card's FULL width — beside a checkbox and a menu the grid lost a quarter of the card and clipped a badge (browser pass, 2026-11-14). A fixed three-column grid, never a wrapping row: the wrapping row is what left the sixth figure alone on a line. Labels fill one grid row and values the next, so a label that takes two lines ("Medical expires" at 390 px) cannot push its own value below its neighbours'.-->
        <dl class="mt-3 grid auto-cols-fr grid-flow-col grid-rows-[auto_auto] gap-x-3 border-t border-edge-subtle pt-3 [&amp;_a]:relative [&amp;_a]:z-raised [&amp;_button]:relative [&amp;_button]:z-raised [&amp;_input]:relative [&amp;_input]:z-raised" data-card-figures="">
          <dt class="min-w-0 self-end text-2xs uppercase tracking-wide text-ink-muted [overflow-wrap:anywhere]">Driver</dt>
          <dd class="mt-0.5 min-w-0 text-sm font-medium text-ink [overflow-wrap:anywhere]">—</dd>
          <dt class="min-w-0 self-end text-2xs uppercase tracking-wide text-ink-muted [overflow-wrap:anywhere]">Gallons</dt>
          <dd class="mt-0.5 min-w-0 text-sm font-medium text-ink [overflow-wrap:anywhere] tabular-nums">—</dd>
        </dl>
        <!--v-if-->
        <!--The rest (D-SM4). Hidden, not absent: find-in-page, a screen reader's cursor and the page tests all read it here. The label column is FIXED, so values start at one x on every card of every list.-->
        <!--v-if-->
      </li>
    </ul>
  </div><!--The pager is a row of the table's card at a desk; on the canvas it needs a surface of its own.-->
  <div class="rounded-surface overflow-hidden bg-surface shadow-card ring-1 ring-edge-subtle mt-2">
    <div data-testid="footer">pagination</div>
  </div>
</div>"
`;

exports[`DataTable rendering, pinned across the R3b extraction > renders the wide table unchanged 1`] = `
"<div class="rounded-surface overflow-hidden bg-surface shadow-card ring-1 ring-edge-subtle">
  <div class="overflow-x-auto max-h-[70vh] overflow-y-auto">
    <table class="min-w-full text-sm whitespace-nowrap">
      <thead class="bg-surface-subtle text-ink-muted shadow-sticky-edge sticky top-0 z-sticky">
        <tr>
          <th scope="col" class="w-10 pl-6 pr-2 py-3"><input type="checkbox" class="size-4 rounded-control border-edge-control accent-brand-600" aria-label="Select all rows"></th>
          <th scope="col" class="font-medium px-4 py-3 text-left min-w-32"><button type="button" class="group inline-flex items-center gap-1 hover:text-ink-secondary">Unit <app-icon-stub icon="path,[object Object]" strokewidth="1.5" class="size-3.5 text-ink-muted"></app-icon-stub></button></th>
          <th scope="col" class="font-medium px-4 py-3 text-left min-w-44">Driver</th>
          <th scope="col" class="font-medium px-4 py-3 text-right tabular-nums"><button type="button" class="group inline-flex items-center gap-1 hover:text-ink-secondary">Gallons <app-icon-stub icon="path,[object Object],path,[object Object],path,[object Object],path,[object Object]" strokewidth="1.5" class="size-3.5 text-ink-tertiary group-hover:text-ink-tertiary"></app-icon-stub></button></th>
          <th scope="col" class="font-medium px-4 py-3 text-left min-w-24">Status</th>
          <th scope="col" class="w-12 pl-2 pr-6"><span class="sr-only">Actions</span></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-edge-subtle">
        <tr class="hover:bg-surface-subtle bg-brand-50/40">
          <td class="w-10 pl-6 pr-2 py-3"><input type="checkbox" class="size-4 rounded-control border-edge-control accent-brand-600" checked="" aria-label="Select Unit 204"></td>
          <td class="px-4 py-3 text-left font-medium text-ink">Unit 204</td>
          <td class="px-4 py-3 text-left">Marcus Reyes</td>
          <td class="px-4 py-3 text-right tabular-nums">118.4</td>
          <td class="px-4 py-3 text-left"><span data-testid="status-slot">ok</span></td>
          <td class="w-12 pl-2 pr-6 text-right py-2"><button type="button" data-testid="row-actions">Actions</button></td>
        </tr>
        <tr class="bg-surface-subtle/60">
          <td colspan="6" class="px-6 py-3">
            <div data-testid="expanded">detail</div>
          </td>
        </tr>
        <tr class="hover:bg-surface-subtle">
          <td class="w-10 pl-6 pr-2 py-3"><input type="checkbox" class="size-4 rounded-control border-edge-control accent-brand-600" aria-label="Select Unit 991"></td>
          <td class="px-4 py-3 text-left font-medium text-ink">Unit 991</td>
          <td class="px-4 py-3 text-left"><span class="text-ink-tertiary">—</span></td>
          <td class="px-4 py-3 text-right tabular-nums"><span class="text-ink-tertiary">—</span></td>
          <td class="px-4 py-3 text-left"><span data-testid="status-slot">none</span></td>
          <td class="w-12 pl-2 pr-6 text-right py-2"><button type="button" data-testid="row-actions">Actions</button></td>
        </tr>
        <!--v-if-->
      </tbody>
    </table>
  </div>
  <div data-testid="footer">pagination</div>
</div>"
`;
