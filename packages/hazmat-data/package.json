{
  "name": "@hazmat/data",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "HazmatGuard versioned regulatory dataset + typed loader. Does not import @hazmat/engine.",
  "exports": { ".": { "types": "./src/index.ts", "default": "./src/index.ts" } },
  "types": "./src/index.ts",
  "files": ["src", "datasets"],
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:import": "tsc -p import/tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": { "zod": "4.4.3" },
  "devDependencies": { "@types/node": "26.0.1", "typescript": "6.0.3", "vitest": "4.1.9" }
}
