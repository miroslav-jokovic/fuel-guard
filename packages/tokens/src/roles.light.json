    "shadow-tint-1": {
      "$type": "color",
      "$value": "color-mix(in oklab, var(--ink) 5%, transparent)",
      "$extensions": {
        "silvicom.section": [
          "Shadow TINTS are colours, so they can be light-dark() pairs like everything else. The elevations below are built from them: a shadow value itself cannot go through light-dark(), which takes colours only, and tinting with --ink in dark would cast a light shadow because ink has inverted."
        ]
      }
    },
    "shadow-tint-2": {
      "$type": "color",
      "$value": "color-mix(in oklab, var(--ink) 7%, transparent)"
    },
    "shadow-tint-3": {
      "$type": "color",
      "$value": "color-mix(in oklab, var(--ink) 10%, transparent)"
    },
    "shadow-tint-4": {
      "$type": "color",
      "$value": "color-mix(in oklab, var(--ink) 14%, transparent)"
    },
    "elevation-card": {
      "$type": "dimension",
      "$value": "0 1px 2px var(--shadow-tint-1)",
      "$extensions": {
        "silvicom.section": [
          "elevation \u2014 shadows carry depth so cards and overlays do not need dark perimeters"
        ],
        "silvicom.expose": "shadow"
      }
    },
    "elevation-card-raised": {
      "$type": "dimension",
      "$value": "0 6px 18px var(--shadow-tint-2), 0 1px 3px var(--shadow-tint-1)",
