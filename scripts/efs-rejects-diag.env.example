# OPTIONAL. The diagnostic prompts for these in the console, so you do not need this file at all —
# it exists only so you can avoid retyping across repeated runs.
#
# To use it: copy to  scripts/efs-rejects-diag.env  and paste your REAL values from
# Railway → fleetguardapi-production → Variables. That filename is gitignored, so your secret is
# never committed. Keep the single quotes; put your value between them. Anything set here is used
# as-is and is NOT prompted for; anything left out is asked for interactively.
#
# The SOAP endpoint URL, NOT the ?wsdl document URL.
EFS_SOAP_ENDPOINT_URL='https://paste-the-real-endpoint-here/CardManagementWS'
EFS_SOAP_USERNAME='paste-real-username-here'
EFS_SOAP_PASSWORD='paste-real-password-here'

# ── Only if this deployment uses a client certificate (env.ts:299-309). Point these at
# ── PEM FILES on disk; the script passes them to curl as --cert / --key. Leave unset otherwise.
# EFS_SOAP_CLIENT_CERT_PEM_FILE='/absolute/path/to/client-cert.pem'
# EFS_SOAP_CLIENT_KEY_PEM_FILE='/absolute/path/to/client-key.pem'
