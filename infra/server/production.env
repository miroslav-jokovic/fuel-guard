# Production server values for compose.yml (not secrets — those live in Parameter Store, D-AWS7).
ENV_NAME=production
WEB_HOST=360.silvicominc.com
API_HOST=api.360.silvicominc.com
CONSOLE_HOST=console.360.silvicominc.com
ACME_EMAIL=miki@silvicominc.com
# D-AWS8: two api containers share the egress lane through the lease.
API_REPLICAS=2
DRAIN_SECONDS=45
# true from AWS11 (2026-10-27): this server competes for the scheduler lanes — the EFS feeds and
# card control (`egress`; WEX allowlisted 44.236.127.194 on 10/23) and Med-Stop and every other
# job (`general`, the worker; Med-Stop allowlisted it the same day). The containers wait as
# standbys while Railway holds the leases; Railway api's RUN_SCHEDULERS_IN_PROCESS=false hands them
# over within a lease TTL (AWS-MIGRATION-PLAN.md §5 Cutover, step 3). See compose.yml.
RUN_SCHEDULERS=true
# AWS6a: this server runs the Supabase key watcher (deploy.sh, keywatch.sh) — one server only.
KEYWATCH=true
