# Staging server values for compose.yml (not secrets — those live in Parameter Store, D-AWS7).
ENV_NAME=staging
# D-AWS5 / Q-AWS4 staging twins of production's names. All three resolve to this server since
# 2026-11-17 (staging.360 was the last row GoDaddy published, SOA 2026111700) — AWS10.
WEB_HOST=staging.360.silvicominc.com
API_HOST=staging-api.360.silvicominc.com
CONSOLE_HOST=staging-console.360.silvicominc.com
# Staging's twin of production's careers host (D-AP9), under 360 like the other three.
CAREERS_HOST=staging-careers.360.silvicominc.com
ACME_EMAIL=miki@silvicominc.com
API_REPLICAS=1
# Same as Railway's RAILWAY_DEPLOYMENT_DRAINING_SECONDS on @fleetguard/api production.
DRAIN_SECONDS=45
# false until AWS10's cutover — see compose.yml.
RUN_SCHEDULERS=false
# The key watcher runs on production only; it watches both projects from there.
KEYWATCH=false
# BROKER-MAIL-READER-PLAN P3 (B-1 (c)): the api container runs broker mail's lane and nothing else — no feed.
API_LANES=mail
