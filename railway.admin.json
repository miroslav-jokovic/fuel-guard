{
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "corepack enable && pnpm install --frozen-lockfile --prod=false && rm -rf apps/admin/dist && pnpm --filter @silvicom/admin build",
    "watchPatterns": [
      "apps/admin/**",
      "apps/admin-api/**",
      "packages/**",
      "package.json",
      "pnpm-lock.yaml",
      "railway.admin.json"
    ]
  },
  "deploy": {
    "startCommand": "pnpm --filter @silvicom/admin-api start",
    "healthcheckPath": "/healthz",
    "healthcheckTimeout": 100,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
